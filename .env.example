# PBQuantum Labs — copy to .env and adjust. Never commit .env.
# `scripts/qlab up` creates this file and generates a JWT secret if missing.

ENVIRONMENT=development

# --- database ---------------------------------------------------------------
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum
POSTGRES_DB=quantumlab
POSTGRES_PORT=5432

# --- auth -------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# The API refuses to start in production while this is the default value.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- http -------------------------------------------------------------------
# Must be explicit: cookies are rejected by browsers against a wildcard origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- ai ---------------------------------------------------------------------
# https://console.groq.com/keys — the Copilot degrades gracefully without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
