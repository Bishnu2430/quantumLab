{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuantumIR",
  "description": "Framework-neutral Quantum Circuit Intermediate Representation schema",
  "type": "object",
  "required": ["numQubits", "operations"],
  "properties": {
    "numQubits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32,
      "description": "Number of qubits in the circuit"
    },
    "numClbits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32,
      "default": 0,
      "description": "Number of classical bits for measurement storage"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Operation"
      },
      "description": "Sequential list of quantum operations"
    }
  },
  "definitions": {
    "Operation": {
      "type": "object",
      "required": ["id", "gate", "targets"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this operation instance (e.g. 'op-001')"
        },
        "gate": {
          "type": "string",
          "enum": ["h", "x", "y", "z", "s", "t", "rx", "ry", "rz", "cx", "cz", "swap", "toffoli", "measure", "reset", "barrier"],
          "description": "Name of the quantum gate or operation"
        },
        "targets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "description": "Indices of target qubits"
        },
        "controls": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "description": "Indices of control qubits (if applicable)"
        },
        "clbits": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "description": "Indices of target classical bits (for measure operations)"
        },
        "params": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Numeric rotation parameters (e.g. theta for rx, ry, rz)"
        },
        "moment": {
          "type": "integer",
          "minimum": 0,
          "description": "Time step or column moment in the visual circuit canvas"
        }
      }
    }
  }
}
