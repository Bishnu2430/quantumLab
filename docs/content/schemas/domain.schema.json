{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quantum Curriculum Domain",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "title",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "learningScope": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "lesson.schema.json"
      }
    },
    "references": {
      "type": "array"
    }
  }
}